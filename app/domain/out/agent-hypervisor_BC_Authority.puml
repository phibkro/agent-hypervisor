@startuml

skinparam componentStyle uml2

package "'Capability' Aggregate" <<Rectangle>> {
	class Capability <<(A,#fffab8) Aggregate Root>> {
		String rights
		boolean singleUse
		CapabilityId id
		Principal holder
		ResourceRef resource
		Mode mode
		CapabilityId derivedFrom
		CapabilityState lifecycle
	}
	class CapabilityId <<(V,DarkSeaGreen) Value Object>> {
		String value
	}
	class Principal <<(V,DarkSeaGreen) Value Object>> {
		String kind
		String id
	}
	class ResourceRef <<(V,DarkSeaGreen) Value Object>> {
		String kind
		String locator
	}
	enum Mode {
		ISO
		VAL
		TAG
	}
	enum CapabilityState {
		LIVE
		CONSUMED
		REVOKED
	}
	class CapabilityGranted <<(E,#ff9f4b) Domain Event>> {
		CapabilityId capability
		Principal holder
	}
	class CapabilityRevoked <<(E,#ff9f4b) Domain Event>> {
		CapabilityId capability
	}
	class CapabilityConsumed <<(E,#ff9f4b) Domain Event>> {
		CapabilityId capability
	}
}
package "'CapabilityRequest' Aggregate" <<Rectangle>> {
	class CapabilityRequest <<(A,#fffab8) Aggregate Root>> {
		String id
		String sessionId
		String actingAgentId
		String rights
		String reason
		ResourceRef resource
		RequestState lifecycle
	}
	enum RequestState {
		PENDING
		GRANTED_ONCE
		GRANTED_FOR_SESSION
		DENIED
		EXPIRED
		CANCELLED
	}
	class CapabilityRequested <<(E,#ff9f4b) Domain Event>> {
		String request
	}
	class RequestGranted <<(E,#ff9f4b) Domain Event>> {
		String request
	}
	class RequestDenied <<(E,#ff9f4b) Domain Event>> {
		String request
	}
	class RequestCancelled <<(E,#ff9f4b) Domain Event>> {
		String request
	}
}
package "'Application'" <<Rectangle>> {
	legend left
		This application layer contains flow definitions (visualization available via BPMN Sketch Miner).
	end legend
	class RequestCapability <<(C,#3bc5e9) Command>> {
	}
	class DecideRequest <<(C,#3bc5e9) Command>> {
	}
	class ExpireRequest <<(C,#3bc5e9) Command>> {
	}
	class CancelRequest <<(C,#3bc5e9) Command>> {
	}
	class Mint <<(C,#3bc5e9) Command>> {
	}
	class Revoke <<(C,#3bc5e9) Command>> {
	}
	class Consume <<(C,#3bc5e9) Command>> {
	}
}
Capability --> CapabilityId : derivedFrom
Capability --> Principal : holder
CapabilityGranted --> CapabilityId : capability
CapabilityGranted --> Principal : holder
Capability --> ResourceRef : resource
Capability --> CapabilityState : lifecycle
CapabilityRequest --> ResourceRef : resource
CapabilityRevoked --> CapabilityId : capability
CapabilityRequest --> RequestState : lifecycle
Capability --> Mode : mode
CapabilityConsumed --> CapabilityId : capability
Capability --> CapabilityId : id
legend left
  This bounded context implements the subdomain 'Authority', which contains the following entities:
   - Capability
   - CapabilityRequest
   - ProtectedResource
   - Principal
end legend


@enduml
