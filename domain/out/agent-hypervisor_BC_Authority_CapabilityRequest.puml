@startuml

skinparam componentStyle uml2

package "'CapabilityRequest' Aggregate" <<Rectangle>> {
	class CapabilityRequest <<(A,#fffab8) Aggregate Root>> {
		String id
		String sessionId
		String actingAgentId
		String rights
		String reason
		ResourceRef resource
		RequestState lifecycle
	}
	enum RequestState {
		PENDING
		GRANTED_ONCE
		GRANTED_FOR_SESSION
		DENIED
		EXPIRED
		CANCELLED
	}
	class CapabilityRequested <<(E,#ff9f4b) Domain Event>> {
		String request
	}
	class RequestGranted <<(E,#ff9f4b) Domain Event>> {
		String request
	}
	class RequestDenied <<(E,#ff9f4b) Domain Event>> {
		String request
	}
	class RequestCancelled <<(E,#ff9f4b) Domain Event>> {
		String request
	}
}
CapabilityRequest --> RequestState : lifecycle


@enduml
