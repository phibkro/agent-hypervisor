@startuml

skinparam componentStyle uml2

package "'AttentionItem' Aggregate" <<Rectangle>> {
	class AttentionItem <<(A,#fffab8) Aggregate Root>> {
		String sessionId
		long createdAt
		AttentionItemId id
		AttentionKind kind
		AttentionState lifecycle
	}
	class AttentionItemId <<(V,DarkSeaGreen) Value Object>> {
		String value
	}
	enum AttentionKind {
		APPROVAL
		QUESTION
	}
	enum AttentionState {
		PENDING
		ANSWERED
		DECLINED
		EXPIRED
		CANCELLED
	}
	class Question <<(E,DarkSeaGreen) Entity>> {
		String message
		String formSchema
		String answer
	}
}
AttentionItem --> AttentionKind : kind
AttentionItem --> AttentionState : lifecycle
AttentionItem --> AttentionItemId : id


@enduml
