@startuml

skinparam componentStyle uml2

package "'Session' Aggregate" <<Rectangle>> {
	class Session <<(A,#fffab8) Aggregate Root>> {
		String title
		SessionId id
		ProjectId project
		Checkout checkout
		AgentId leadAgent
		List<Agent> agents
		SandboxRef sandbox
		HarnessSessionRef harnessSession
		SessionFacts facts
		SessionOrigin origin
	}
	class SessionId <<(V,DarkSeaGreen) Value Object>> {
		String value
	}
	class SandboxRef <<(V,DarkSeaGreen) Value Object>> {
		String sandboxId
	}
	class Checkout <<(V,DarkSeaGreen) Value Object>> {
		String repositoryResourceId
		String branch
		String worktreePath
		String storageHostId
		String baseCommit
	}
	class HarnessSessionRef <<(V,DarkSeaGreen) Value Object>> {
		String harness
		String externalId
	}
	class SessionFacts <<(V,DarkSeaGreen) Value Object>> {
		boolean running
		int pendingRequests
		long lastActivityAt
		long archivedAt
	}
	enum SessionOrigin {
		CREATED
		IMPORTED
		FORKED
	}
	class Agent <<(E,DarkSeaGreen) Entity>> {
		AgentId id
		AgentId parent
		AgentRole role
		AgentProfileRef profile
		AgentObservation observedVia
	}
	enum AgentObservation {
		STARTED_BY_CONTROL_PLANE
		REPORTED_BY_HARNESS
	}
	class AgentId <<(V,DarkSeaGreen) Value Object>> {
		String value
	}
	enum AgentRole {
		LEAD
		SUBAGENT
	}
	class AgentProfileRef <<(V,DarkSeaGreen) Value Object>> {
		String profileId
	}
	class Turn <<(E,DarkSeaGreen) Entity>> {
		long startedAt
		long endedAt
		TurnId id
		SessionId session
		StopReason stopReason
		Checkpoint checkpoint
	}
	class Checkpoint <<(V,DarkSeaGreen) Value Object>> {
		String commit
		long takenAt
	}
	class TurnId <<(V,DarkSeaGreen) Value Object>> {
		String value
	}
	enum StopReason {
		END_TURN
		CANCELLED
		ERROR
		MAX_TOKENS
		REFUSAL
	}
	class SessionStarted <<(E,#ff9f4b) Domain Event>> {
		SessionId session
		ProjectId project
		AgentId leadAgent
	}
	class SubagentSpawned <<(E,#ff9f4b) Domain Event>> {
		SessionId session
		AgentId agent
		AgentId parent
	}
	class TurnStarted <<(E,#ff9f4b) Domain Event>> {
		SessionId session
		TurnId turn
	}
	class TurnEnded <<(E,#ff9f4b) Domain Event>> {
		SessionId session
		TurnId turn
		StopReason stopReason
	}
	class SessionArchived <<(E,#ff9f4b) Domain Event>> {
		SessionId session
	}
	class SessionForked <<(E,#ff9f4b) Domain Event>> {
		SessionId session
		SessionId forkedFrom
		TurnId fromTurn
	}
	class SessionWentInactive <<(E,#ff9f4b) Domain Event>> {
		SessionId session
	}
	class SessionReactivated <<(E,#ff9f4b) Domain Event>> {
		SessionId session
	}
	class SessionCommands <<(S,DarkSeaGreen) Service>> {
		SessionId start(ProjectId project, AgentProfileRef lead)
		TurnId prompt(SessionId session, String message)
		void cancel(SessionId session)
		SessionId fork(SessionId session, TurnId fromTurn)
		SessionId importFromHarness(ProjectId project, HarnessSessionRef ref)
		void archive(SessionId session)
		void unarchive(SessionId session)
	}
}
SessionArchived --> SessionId : session
SubagentSpawned --> AgentId : parent
SessionStarted --> SessionId : session
Agent --> AgentObservation : observedVia
Agent --> AgentId : id
SessionForked --> TurnId : fromTurn
SessionForked --> SessionId : session
SessionWentInactive --> SessionId : session
Session --> SessionFacts : facts
Session --> SessionId : id
Session --> Checkout : checkout
Session --> SessionOrigin : origin
Turn --> TurnId : id
Session "1" *--> "*" Agent : agents
SessionReactivated --> SessionId : session
Session --> HarnessSessionRef : harnessSession
SubagentSpawned --> AgentId : agent
TurnStarted --> SessionId : session
Agent --> AgentRole : role
Turn --> StopReason : stopReason
SessionForked --> SessionId : forkedFrom
Session --> AgentId : leadAgent
Agent --> AgentId : parent
TurnEnded --> TurnId : turn
Turn --> SessionId : session
TurnStarted --> TurnId : turn
SessionStarted --> AgentId : leadAgent
Session --> SandboxRef : sandbox
SubagentSpawned --> SessionId : session
TurnEnded --> StopReason : stopReason
Agent --> AgentProfileRef : profile
Turn --> Checkpoint : checkpoint
TurnEnded --> SessionId : session


@enduml
