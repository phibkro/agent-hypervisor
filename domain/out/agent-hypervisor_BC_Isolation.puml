@startuml

skinparam componentStyle uml2

package "'Sandbox' Aggregate" <<Rectangle>> {
	class Sandbox <<(A,#fffab8) Aggregate Root>> {
		String id
		String sessionId
		String host
		List<String> mounts
		List<String> allowedEgress
		SandboxState lifecycle
	}
	enum SandboxState {
		RUNNING
		STOPPED
		DESTROYED
	}
	class SandboxRunning <<(E,#ff9f4b) Domain Event>> {
		String sandbox
	}
	class SandboxStopped <<(E,#ff9f4b) Domain Event>> {
		String sandbox
	}
	class SandboxDestroyed <<(E,#ff9f4b) Domain Event>> {
		String sandbox
	}
}
package "'Host' Aggregate" <<Rectangle>> {
	class Host <<(A,#fffab8) Aggregate Root>> {
		String name
		String tailnetAddress
		boolean compute
		boolean storage
	}
}
package "'Application'" <<Rectangle>> {
	legend left
		This application layer contains flow definitions (visualization available via BPMN Sketch Miner).
	end legend
	class Provision <<(C,#3bc5e9) Command>> {
	}
	class StopIdle <<(C,#3bc5e9) Command>> {
	}
	class Stop <<(C,#3bc5e9) Command>> {
	}
	class Start <<(C,#3bc5e9) Command>> {
	}
	class Destroy <<(C,#3bc5e9) Command>> {
	}
}
Sandbox --> SandboxState : lifecycle
legend left
  This bounded context implements the subdomain 'Isolation', which contains the following entities:
   - Sandbox
   - Host
end legend


@enduml
