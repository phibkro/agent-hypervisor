@startuml

skinparam componentStyle uml2

package "'Host' Aggregate" <<Rectangle>> {
	class Host <<(A,#fffab8) Aggregate Root>> {
		String name
		String tailnetAddress
		HostId id
		List<HostRole> roles
	}
	class HostId <<(V,DarkSeaGreen) Value Object>> {
		String value
	}
	enum HostRole {
		COMPUTE
		STORAGE
	}
}
Host --> HostId : id
Host "1" *--> "*" HostRole : roles


@enduml
