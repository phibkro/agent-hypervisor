@startuml

skinparam componentStyle uml2

package "'SecretBinding' Aggregate" <<Rectangle>> {
	class SecretBinding <<(A,#fffab8) Aggregate Root>> {
		String secretRef
		String placeholder
		String allowedHosts
		String capabilityId
		SecretBindingId id
	}
	class SecretBindingId <<(V,DarkSeaGreen) Value Object>> {
		String value
	}
}
SecretBinding --> SecretBindingId : id


@enduml
