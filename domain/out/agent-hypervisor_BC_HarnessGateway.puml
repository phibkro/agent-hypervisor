@startuml

skinparam componentStyle uml2

package "'HarnessConnection' Aggregate" <<Rectangle>> {
	class HarnessConnection <<(A,#fffab8) Aggregate Root>> {
		String sessionId
		String sandboxId
		List<String> advertisedCapabilities
		HarnessConnectionId id
		HarnessKind harness
	}
	class HarnessConnectionId <<(V,DarkSeaGreen) Value Object>> {
		String value
	}
	enum HarnessKind {
		OMP
		CLAUDE_CODE
		CODEX
		PI
		CUSTOM
	}
}
HarnessConnection --> HarnessConnectionId : id
HarnessConnection --> HarnessKind : harness
legend left
  This bounded context implements the subdomain 'HarnessAdaptation'.
end legend


@enduml
