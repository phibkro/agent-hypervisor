@startuml

skinparam componentStyle uml2

package "'Session' Aggregate" <<Rectangle>> {
	class Session <<(A,#fffab8) Aggregate Root>> {
		String projectId
		String title
		int forkedAtTurn
		SessionId id
		Worktree worktree
		List<Turn> turns
		List<Agent> agents
		HarnessSessionRef harnessSession
		SessionId forkedFrom
		SessionState lifecycle
	}
	class SessionId <<(V,DarkSeaGreen) Value Object>> {
		String value
	}
	enum SessionState {
		ACTIVE
		RUNNING
		ARCHIVED
	}
	class Worktree <<(V,DarkSeaGreen) Value Object>> {
		String repository
		String branch
		String location
	}
	class Turn <<(E,DarkSeaGreen) Entity>> {
		int turnNumber
		String stopReason
		Checkpoint checkpoint
	}
	class Checkpoint <<(V,DarkSeaGreen) Value Object>> {
		String commit
	}
	class Agent <<(E,DarkSeaGreen) Entity>> {
		String profile
		boolean lead
		boolean reportedByHarness
		AgentId id
		AgentId parent
	}
	class AgentId <<(V,DarkSeaGreen) Value Object>> {
		String value
	}
	class HarnessSessionRef <<(V,DarkSeaGreen) Value Object>> {
		String harness
		String externalId
	}
	class Question <<(E,DarkSeaGreen) Entity>> {
		String message
		String form
		String answer
	}
	class SessionStarted <<(E,#ff9f4b) Domain Event>> {
		SessionId session
	}
	class TurnStarted <<(E,#ff9f4b) Domain Event>> {
		int turn
		SessionId session
	}
	class TurnEnded <<(E,#ff9f4b) Domain Event>> {
		int turn
		String stopReason
		SessionId session
	}
	class SessionArchived <<(E,#ff9f4b) Domain Event>> {
		SessionId session
	}
	class SessionResumed <<(E,#ff9f4b) Domain Event>> {
		SessionId session
	}
	class SessionForked <<(E,#ff9f4b) Domain Event>> {
		int fromTurn
		SessionId session
		SessionId forkedFrom
	}
	class SessionImported <<(E,#ff9f4b) Domain Event>> {
		SessionId session
		HarnessSessionRef source
	}
}
package "'Project' Aggregate" <<Rectangle>> {
	class Project <<(A,#fffab8) Aggregate Root>> {
		String id
		String name
		List<String> resources
	}
}
package "'AgentProfile' Aggregate" <<Rectangle>> {
	class AgentProfile <<(A,#fffab8) Aggregate Root>> {
		String id
		String harness
		String model
		String instructions
		List<String> tools
		int version
	}
}
package "'Application'" <<Rectangle>> {
	legend left
		This application layer contains flow definitions (visualization available via BPMN Sketch Miner).
	end legend
	class StartSession <<(C,#3bc5e9) Command>> {
	}
	class SendPrompt <<(C,#3bc5e9) Command>> {
	}
	class EndTurn <<(C,#3bc5e9) Command>> {
	}
	class ForkSession <<(C,#3bc5e9) Command>> {
	}
	class ArchiveSession <<(C,#3bc5e9) Command>> {
	}
	class ResumeSession <<(C,#3bc5e9) Command>> {
	}
	class ImportSession <<(C,#3bc5e9) Command>> {
	}
}
SessionArchived --> SessionId : session
SessionImported --> HarnessSessionRef : source
Session --> HarnessSessionRef : harnessSession
SessionImported --> SessionId : session
TurnStarted --> SessionId : session
SessionStarted --> SessionId : session
SessionForked --> SessionId : forkedFrom
Agent --> AgentId : parent
Agent --> AgentId : id
Session --> SessionState : lifecycle
SessionForked --> SessionId : session
Session --> SessionId : forkedFrom
Session "1" *--> "*" Turn : turns
Session --> SessionId : id
Turn --> Checkpoint : checkpoint
Session --> Worktree : worktree
TurnEnded --> SessionId : session
SessionResumed --> SessionId : session
Session "1" *--> "*" Agent : agents
legend left
  This bounded context implements the subdomain 'AgentWork', which contains the following entities:
   - Project
   - Session
   - Turn
   - Agent
   - AgentProfile
   - Worktree
   - Checkpoint
   - Question
   - HarnessSession
end legend


@enduml
