@startuml

skinparam componentStyle uml2

package "'AgentWork' Core Domain" <<Rectangle>> {
	class Project <<(E,DarkSeaGreen) Entity>> {
		String name
	}
	class Session <<(E,DarkSeaGreen) Entity>> {
		String title
	}
	class Turn <<(E,DarkSeaGreen) Entity>> {
		int turnNumber
	}
	class Agent <<(E,DarkSeaGreen) Entity>> {
		String role
	}
	class AgentProfile <<(E,DarkSeaGreen) Entity>> {
		String harness
		String model
	}
	class Worktree <<(E,DarkSeaGreen) Entity>> {
		String branch
	}
	class Checkpoint <<(E,DarkSeaGreen) Entity>> {
		String commit
	}
	class Question <<(E,DarkSeaGreen) Entity>> {
		String message
	}
	class HarnessSession <<(E,DarkSeaGreen) Entity>> {
		String externalId
	}
}
legend left
  This subdomain is part of the 'AgentHypervisor' domain.

  Units of agent work: who does them, on what code, and how they branch and pause.
end legend


@enduml
